# Copy to .env and fill in what you need. Every value is optional.
# docker compose reads this file automatically, and so do the npm dev scripts.

# Port on your machine (docker compose) or for the server (npm run dev).
PORT=8080

# Only used when running the server outside Docker.
MONGODB_URI=mongodb://127.0.0.1:27017/eaternity

# Public address of the site. Used for the Stripe return links. Leave empty to
# use whatever host the browser connected to.
PUBLIC_URL=

# Admin panel sign-in. If ADMIN_PASSWORD is empty, one is generated on first
# start, printed in the logs and saved in the data volume.
ADMIN_EMAIL=admin@eaternity.local
ADMIN_PASSWORD=

# Signs login tokens. Generated and saved in the data volume when empty.
JWT_SECRET=

# Stripe secret key (sk_test_... or sk_live_...). Without it, checkout runs in
# demo mode and orders are marked as paid straight away.
STRIPE_SECRET_KEY=
# Prices are stored in USD. To charge in another currency, set its code and the
# rate from USD, for example bdt and 80.
PAYMENT_CURRENCY=usd
PAYMENT_EXCHANGE_RATE=1

# Order confirmation emails. Without SMTP_USER and SMTP_PASS no email is sent.
# For Gmail, use an app password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
