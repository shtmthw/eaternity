# Copy to .env and fill in what you need. Every value is optional.
# docker compose reads this file, and so do the npm scripts.

# Port on your machine (docker compose) or for the server (npm run dev, npm start).
PORT=8080

# Public address of the site, used for the Stripe return links. Leave empty to
# use whatever address the browser connected to.
PUBLIC_URL=
# Set to true behind a reverse proxy, so X-Forwarded-For and -Proto are trusted.
TRUST_PROXY=false

# The admin account. If ADMIN_PASSWORD is empty, a password is generated on
# first start, printed in the logs and saved as admin-password in the data folder.
ADMIN_EMAIL=admin@eaternity.local
ADMIN_PASSWORD=

# Prices are entered and charged in this currency.
CURRENCY=usd
DELIVERY_FEE=2

# Stripe secret key (sk_test_... or sk_live_...). Without it, checkout runs in
# demo mode and orders count as paid straight away.
STRIPE_SECRET_KEY=

# Order confirmation emails. Without SMTP_USER and SMTP_PASS no email is sent.
# For Gmail, use an app password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
