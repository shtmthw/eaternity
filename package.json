{
  "name": "eaternity",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web,admin -c gray,green,blue \"npm run dev -w @eaternity/server\" \"npm run dev -w @eaternity/web\" \"npm run dev -w @eaternity/admin\"",
    "build": "npm run build -w @eaternity/web -w @eaternity/admin -w @eaternity/server",
    "start": "npm run start -w @eaternity/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=22.22"
  }
}
